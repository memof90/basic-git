import Uikit 

class ViewController: UIViewController {

    let myPersonalInformation = InformationModel(
        myName: "Guillermo",
        color: "yellow",
        favoriteFood: "Burger"
    )

    override func viewDidLoad() {
        super.viewDidLoad()

        myFavoriteFood(foodName: myPersonalInformation.favoriteFood)
    }

    func myPersonalDescription() -> String {
        return "My name is \(myPersonalInformation.myName), my favorite color is \(myPersonalInformation.color), and my favorite food is \(myPersonalInformation.favoriteFood)."
    }

    func myFavoriteFood(foodName: String) {
        print(foodName)
    }

    func myFavoriteColor(color: String) -> String {
        return color
    }
}
